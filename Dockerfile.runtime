# Asha on AgentCore Runtime. ARM64 is required by Runtime.
FROM public.ecr.aws/docker/library/python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

# Dependencies install against a stub package so this layer is keyed on pyproject.toml
# alone. Copying src first would rebuild and re-upload every dependency on any code
# change, which is most of the image.
COPY pyproject.toml README.md ./
RUN mkdir -p src/donorpanel \
 && touch src/donorpanel/__init__.py \
 && pip install --no-cache-dir . \
 && pip uninstall -y donorpanel \
 && rm -rf src

COPY src ./src
RUN pip install --no-cache-dir --no-deps .

# Runtime health-checks /ping and calls /invocations, both from BedrockAgentCoreApp.
EXPOSE 8080
CMD ["python", "-m", "donorpanel.entrypoints.runtime"]
